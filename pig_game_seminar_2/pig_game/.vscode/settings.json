{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐷 Run Pig Game (module)",
            "type": "python",
            "request": "launch",
            "module": "src.game_cmd",
            "justMyCode": true,
            "console": "integratedTerminal"
        },
        {
            "name": "🧪 Run Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-v",
                "--disable-warnings"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "📊 Run Coverage",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "--cov=src",
                "--cov-report=term-missing"
            ],
            "console": "integratedTerminal"
        }
    ],

    // --- Makefile integration ---
    "makefile.configureOnOpen": false,

    // --- Linting & Formatting ---
    "python.linting.enabled": true,
    "python.linting.flake8Enabled": true,
    "python.linting.flake8Args": [
        "--config=${workspaceFolder}/.flake8"
    ],
    "python.formatting.provider": "black",
    "python.formatting.blackArgs": [
        "--line-length=88"
    ],

    // --- Editor appearance ---
    "editor.rulers": [88],
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 88,

    // --- Optional: disable Ruff if installed ---
    "ruff.enable": false,

    // --- Disable problematic JSON schema validation ---
    "json.validate.enable": true,
    "json.schemas": []
}
